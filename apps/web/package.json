{
  "name": "@pokopia-scene-editor/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b && vite build && node ../../scripts/verify-runtime-assets.mjs --source ../../assets/pokopia_image_sources --output dist/assets/pokopia_image_sources && node ../../scripts/verify-auth-bundle-secrets.mjs",
    "smoke": "pnpm --filter @pokopia-scene-editor/scene-core build && playwright test --project=chromium --workers=1",
    "smoke:auth": "node scripts/run-auth-smoke.mjs"
  },
  "dependencies": {
    "@pokopia-scene-editor/scene-core": "workspace:*",
    "@supabase/supabase-js": "^2.107.0",
    "html-to-image": "^1.11.13",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "4.1.6"
  }
}
