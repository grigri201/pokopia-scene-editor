# Pokopia runtime art is content-addressed by release discipline: update the
# path or filename when a source image changes.
/assets/pokopia_image_sources/*
  Cache-Control: public, max-age=31536000, immutable

# UI static artwork should stay cacheable while preserving Cloudflare Pages'
# default ETag revalidation after it becomes stale.
/assets/asset-thumbnails/*
  Cache-Control: public, max-age=604800, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate
