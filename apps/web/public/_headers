# Pokopia material images are content-addressed by release discipline: update the
# path or filename when a source image changes so cached copies can stay immutable.
/assets/pokopia_image_sources/*
  Cache-Control: public, max-age=31536000, immutable

/assets/asset-thumbnails/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate
