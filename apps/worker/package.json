{
  "name": "@pokopia-scene-editor/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pokopia-scene-editor/web build && wrangler dev --config wrangler.toml",
    "types": "wrangler types --config wrangler.toml",
    "types:check": "wrangler types --config wrangler.toml --check",
    "deploy:dry-run": "pnpm --filter @pokopia-scene-editor/web build && wrangler deploy --config wrangler.toml --dry-run",
    "deploy": "pnpm --filter @pokopia-scene-editor/web build && wrangler deploy --config wrangler.toml",
    "mcp:smoke": "vitest run --environment node src/mcp.test.ts",
    "bundle:check": "pnpm --filter @pokopia-scene-editor/web build && wrangler deploy --config wrangler.toml --dry-run --outdir dist/worker-bundle --metafile dist/worker-bundle/metafile.json && node ../../scripts/verify-worker-bundle.mjs dist/worker-bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --environment node",
    "build": "pnpm run deploy:dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pokopia-scene-editor/scene-core": "workspace:*",
    "agents": "^0.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "wrangler": "4.94.0"
  }
}
