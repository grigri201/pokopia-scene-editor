{
  "name": "pokopia-scene-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pokopia-scene-editor/web dev",
    "preview": "pnpm --filter @pokopia-scene-editor/web preview",
    "typecheck": "pnpm --filter @pokopia-scene-editor/scene-core typecheck && pnpm --filter @pokopia-scene-editor/web typecheck",
    "test": "pnpm --filter @pokopia-scene-editor/scene-core test && pnpm --filter @pokopia-scene-editor/web test",
    "test:watch": "pnpm --filter @pokopia-scene-editor/web test:watch",
    "build": "pnpm --filter @pokopia-scene-editor/scene-core build && pnpm --filter @pokopia-scene-editor/web build",
    "smoke": "pnpm --filter @pokopia-scene-editor/web smoke"
  }
}
